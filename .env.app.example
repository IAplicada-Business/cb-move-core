# Tokens locais da equipe — copie para .env.app (nunca commitar)

# Personal Access Token da Management API (formato sbp_...)
# https://supabase.com/dashboard/account/tokens
# NÃO coloque sb_secret_ nem service_role nesta variável.
SUPABASE_ACCESS_TOKEN=

# Service role (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Chave secreta do projeto Supabase (formato sb_secret_...)
# Distinta do PAT (SUPABASE_ACCESS_TOKEN) e do JWT service_role acima.
SUPABASE_SECRET_KEY=

# Anthropic — estruturação S/O/P na edge transcribe-audio
# Também configurar no remoto: supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=

# Transcrição de áudio (Whisper) — use GROQ_API_KEY (recomendado) ou OPENAI_API_KEY
# supabase secrets set GROQ_API_KEY=...  (ou OPENAI_API_KEY=...)
GROQ_API_KEY=
OPENAI_API_KEY=

# Focus NFe
FOCUSNFE_TOKEN=
# Token revenda (opcional) — PATCH empresa / upload certificado
FOCUSNFE_REVENDA_TOKEN=
FOCUSNFE_EMPRESA_ID=230418
FOCUSNFE_CNPJ_PRESTADOR=42082795000174
FOCUSNFE_AMBIENTE=homologacao
# Secret do webhook nfsen (gerado por scripts/register-focus-webhook.py)
FOCUSNFE_WEBHOOK_SECRET=
# Certificado A1 local (caminho relativo ao repo; arquivo no .gitignore)
FOCUSNFE_CERTIFICADO_PATH=docs/seu-certificado.p12
FOCUSNFE_CERTIFICADO_SENHA=

# n8n
N8N_API_KEY=

# Cora — Integração Direta mTLS (boletos, ambiente STAGE)
# Docs: https://developers.cora.com.br/docs/client-credentials-int-direta
#       https://developers.cora.com.br/docs/utiliza%C3%A7%C3%A3o-das-apis
# Testar token: python scripts/test-cora-token.py
# Aplicar no Supabase: python scripts/apply-integracao-cora.py --from-env
CORA_CLIENT_ID=int-4ko2cwTrOq2NBMyapma5OC
CORA_AMBIENTE=stage
CORA_API_BASE=https://matls-clients.api.stage.cora.com.br
CORA_CERTIFICATE_PATH=docs/cert_key_cora_stage_2026_07_14/certificate.pem
CORA_PRIVATE_KEY_PATH=docs/cert_key_cora_stage_2026_07_14/private-key.key
# Opcional — sobrescreve URL mTLS (padrão stage: matls-clients.api.stage.cora.com.br)
# CORA_API_BASE=https://matls-clients.api.stage.cora.com.br

# Tokens locais da equipe IAPLICADA (scripts, Supabase CLI, integrações).
# Copie para .env.app na raiz do projeto — NUNCA commite o .env.app.
#
# O .env principal continua gerenciado pelo Lovable (VITE_* públicas).
# Este arquivo é só para segredos de desenvolvimento/ops.

# Supabase Management API (scripts/apply-seed-*.py, supabase link)
SUPABASE_ACCESS_TOKEN=

# Service role — scripts Python e testes server-side locais
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: sobrescrever URL (senão usa SUPABASE_URL / VITE_SUPABASE_URL do .env Lovable)
# SUPABASE_URL=https://grlkbtnwvxorlfglyzid.supabase.co

# Focus NFe (scripts/apply-integracao-focusnfe.py)
FOCUSNFE_TOKEN=
FOCUSNFE_CNPJ_PRESTADOR=42082795000174
FOCUSNFE_AMBIENTE=homologacao

# n8n (scripts locais de webhook)
